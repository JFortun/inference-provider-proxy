# Example configuration for inference_provider_proxy (ipp).
#
# Copy to `.env` and fill in the real provider credential. `.env` is
# git-ignored; this example is committed and must contain placeholders only.
# All variables use the `IPP_` prefix. There is no client token: the proxy is
# intentionally open on a trusted LAN (spec FR-016).

# --- Provider ---------------------------------------------------------------
# Base address of the upstream provider.
IPP_UPSTREAM_BASE_URL=replace-with-your-provider-url
# The single paid provider key. Substituted server-side; never sent to clients.
IPP_UPSTREAM_API_KEY=replace-with-your-provider-key

# --- Bind -------------------------------------------------------------------
IPP_BIND_HOST=0.0.0.0
IPP_BIND_PORT=13306

# --- Concurrency and queueing ----------------------------------------------
# Maximum in-flight chat requests against the provider (default: 1).
IPP_PROVIDER_CONCURRENCY=1
# Maximum number of waiters before new arrivals are rejected (default: 64).
IPP_MAX_QUEUE_DEPTH=64
# Maximum time a request may wait for a slot, in seconds (default: 900).
IPP_QUEUE_TIMEOUT=900
# Maximum time to release the slot after a mid-stream client disconnect, in seconds (default: 15).
IPP_DISCONNECT_RELEASE=15

# --- Upstream timeouts and retries -----------------------------------------
# Connect/read timeout for provider calls, in seconds (default: 600).
IPP_UPSTREAM_TIMEOUT=600
# Idle timeout for a stalled stream, in seconds (default: 120).
IPP_STREAM_IDLE_TIMEOUT=120
# Bounded retry budget for transient provider failures (default: 2).
IPP_MAX_RETRIES=2
# Client identity sent upstream so edge layers do not block the default UA.
IPP_USER_AGENT=ipp/0.1

# --- Metrics and logging ----------------------------------------------------
# Ring-buffer retention per latency series (default: 2000).
IPP_METRICS_RETENTION=2000
# Metadata (models/usage) cache lifetime in seconds (default: 30).
IPP_METADATA_CACHE_TTL=30
# Emit redacted request access logs (default: true).
IPP_ACCESS_LOG=true
# Level for the proxy's own log sections: debug|info|warning|error|critical|trace
# (default: info). Also sets uvicorn's level when passed as --log-level.
IPP_LOG_LEVEL=info
# Colorize the log stream: auto (terminal only), always or never (default: auto).
# NO_COLOR is honoured; FORCE_COLOR forces colors on under auto.
IPP_LOG_COLOR=auto
